# URL of the token server's endpoint.
#
# - Local token server + iOS Simulator:  http://localhost:3000/api/token
# - Local token server + physical iPhone: http://<YOUR-COMPUTER-LAN-IP>:3000/api/token
#       (find it with `ipconfig getifaddr en0`; phone & computer on same Wi-Fi)
# - Deployed to Vercel:                    https://<project>.vercel.app/api/token
EXPO_PUBLIC_TOKEN_URL=http://localhost:3000/api/token
