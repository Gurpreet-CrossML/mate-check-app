{
  "expo": {
    "name": "Talking Avatar",
    "slug": "talking-avatar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "talkingavatar",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gurpreet.talkingavatar",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "We need the microphone so you can talk to the AI avatar.",
        "NSCameraUsageDescription": "Camera access is required by the realtime engine.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "package": "com.gurpreet.talkingavatar",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "659e33c6-15e6-45f5-a8d5-79a79e58588e"
      }
    }
  }
}
